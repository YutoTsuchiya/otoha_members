{
  "name": "otoha-members",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "types": "wrangler types",
    "typecheck": "tsc -b && tsc -p functions/tsconfig.json",
    "cf:dev": "wrangler pages dev",
    "db:local": "wrangler d1 execute otoha-members --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute otoha-members --remote --file=./schema.sql",
    "deploy": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  }
}
