{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "otoha-members",
  "main": "functions/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "secrets": {
    "required": ["AUTH_PASSWORD", "AUTH_SECRET"]
  },
  "compatibility_date": "2026-05-14",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "otoha-members",
      // ↓ `npx wrangler d1 create otoha-members` の出力の database_id に置き換える
      //   （ローカル開発だけなら未設定のままでも動きます）
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
