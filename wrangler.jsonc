{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "otoha-members",
  "main": "functions/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "secrets": {
    "required": ["AUTH_PASSWORD", "AUTH_SECRET"]
  },
  "compatibility_date": "2026-05-14",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "otoha-members",
      "database_id": "9631498e-a915-4743-b4f2-a052991238f3"
    }
  ]
}
